# Registry repository prefix. The build script publishes four repositories below it.
IMAGE_PREFIX=ci-internal.routemarket.ai/pxtech/trustcaptcha
IMAGE_TAG=prod

# Existing overlay network shared with the already-running Caddy service.
CADDY_NETWORK=caddy

# Public demo key. It is intentionally not a secret.
DEMO_SITE_KEY=tc_pk_trustcaptcha_public_demo

# External data services. Keep the real values only in the private Stack env.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/trustcaptcha
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379/0

SEED_ADMIN_EMAIL=admin@xuandev.com
SEED_ADMIN_PASSWORD=replace-with-a-long-random-password
SEED_CUSTOMER_NAME=TrustCaptcha
SEED_CUSTOMER_SLUG=trustcaptcha
ACTIVE_TOKEN_SIGNING_KEY_ID=prod-k1

# Runtime security keys. Generate independent random values for every field.
AUTH_SECRET=replace-with-at-least-32-random-bytes
SECRET_HASH_PEPPER=replace-with-a-random-pepper
IP_HASH_PEPPER=replace-with-a-different-random-pepper
REQUEST_BINDING_PEPPER=replace-with-another-random-pepper
IP_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
TOKEN_SIGNING_KEYS=prod-k1:replace-with-32-byte-base64url-key
RETENTION_CRON_SECRET=replace-with-a-long-random-token
DEMO_SITE_SECRET=tc_sk_replace-with-a-long-random-secret

# Keep true until Creem sandbox checkout/webhooks have passed end-to-end tests.
CREEM_TEST_MODE=true
CREEM_PRO_MONTHLY_PRODUCT_ID=
CREEM_PRO_YEARLY_PRODUCT_ID=
CREEM_SCALE_MONTHLY_PRODUCT_ID=
CREEM_SCALE_YEARLY_PRODUCT_ID=
CREEM_PRIVATE_MONTHLY_PRODUCT_ID=
CREEM_PRIVATE_YEARLY_PRODUCT_ID=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
