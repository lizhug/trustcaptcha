{
  "name": "trustcaptcha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm db:generate && turbo run build",
    "dev": "pnpm db:generate && turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "pnpm db:generate && turbo run typecheck",
    "test": "pnpm db:generate && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:format": "pnpm --filter @trustcaptcha/database db:format",
    "db:generate": "pnpm --filter @trustcaptcha/database db:generate",
    "db:validate": "pnpm --filter @trustcaptcha/database db:validate"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.23",
    "prettier": "3.6.2",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
