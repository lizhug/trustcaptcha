NODE_ENV=development
TRUSTCAPTCHA_STANDALONE=false

# PostgreSQL and Redis
DATABASE_URL=postgresql://trustcaptcha:trustcaptcha@localhost:5432/trustcaptcha
REDIS_URL=redis://:change-me@localhost:6379/0

# Dashboard authentication
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:4301
DASHBOARD_ORIGIN=http://localhost:4301
SEED_ADMIN_EMAIL=admin@trustcaptcha.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
SEED_DEMO_ORIGIN=http://localhost:4303
SEED_SIGNUP_ORIGIN=http://localhost:4301
SEED_CUSTOMER_NAME=TrustCaptcha Demo
SEED_CUSTOMER_SLUG=trustcaptcha-demo

# Public service URLs
NEXT_PUBLIC_API_URL=http://localhost:4302
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:4301
NEXT_PUBLIC_SITE_URL=http://localhost:4303
TRUSTCAPTCHA_API_URL=http://localhost:4302
NEXT_PUBLIC_DEMO_SITE_KEY=tc_pk_replace_with_created_site_key
NEXT_PUBLIC_SIGNUP_SITE_KEY=tc_pk_replace_with_created_site_key
TRUSTCAPTCHA_DEMO_SECRET=tc_sk_replace_with_created_site_secret
TRUSTCAPTCHA_SIGNUP_SECRET=tc_sk_replace_with_created_site_secret

# Creem billing (use test products until launch)
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_PRO_MONTHLY_PRODUCT_ID=
CREEM_PRO_YEARLY_PRODUCT_ID=
CREEM_SCALE_MONTHLY_PRODUCT_ID=
CREEM_SCALE_YEARLY_PRODUCT_ID=
CREEM_PRIVATE_MONTHLY_PRODUCT_ID=
CREEM_PRIVATE_YEARLY_PRODUCT_ID=

# Invoke POST /api/internal/retention from a daily scheduler with this bearer secret.
RETENTION_CRON_SECRET=replace-with-independent-random-value

# Security key material. Use independent random values in production.
TOKEN_SIGNING_KEYS=dev-k1:replace-with-32-byte-base64url-key
ACTIVE_TOKEN_SIGNING_KEY_ID=dev-k1
SECRET_HASH_PEPPER=replace-with-independent-random-value
IP_HASH_PEPPER=replace-with-independent-random-value
IP_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
REQUEST_BINDING_PEPPER=replace-with-independent-random-value
TRUST_PROXY=false
